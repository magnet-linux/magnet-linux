+// Quote workspace names as Lua strings, including quotes and control bytes.
+static std::string luaQuote(const std::string& value) {
+  std::string result = "\"";
+  for (unsigned char c : value) {
+    if (c == '\\' || c == '"') {
+      result += '\\';
+      result += c;
+    } else if (c < 32 || c == 127) {
+      result += fmt::format("\\{:03}", static_cast<unsigned>(c));
+    } else {
+      result += c;
+    }
+  }
+  return result + '"';
+}
+
+std::string IPC::dispatch(const std::string& dispatcher, const std::string& arg) {
+  if (dispatcher == "workspace") {
+    return getSocket1Reply("/dispatch hl.dsp.focus({ workspace = " + luaQuote(arg) + " })");
+  }
+  if (dispatcher == "focusworkspaceoncurrentmonitor") {
+    return getSocket1Reply("/dispatch hl.dsp.focus({ workspace = " + luaQuote(arg) +
+                           ", monitor = \"current\" })");
+  }
+  if (dispatcher == "togglespecialworkspace") {
+    return getSocket1Reply("/dispatch hl.dsp.workspace.toggle_special(" +
+                           (arg.empty() ? "" : luaQuote(arg)) + ")");
+  }
+  throw std::runtime_error("Unsupported Hyprland dispatcher: " + dispatcher);
+}
